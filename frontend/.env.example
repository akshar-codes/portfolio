# Local development can use the Vite proxy to reach Render without browser
# CORS or cross-site cookie issues. Set VITE_API_BASE_URL=/api and the target
# below in frontend/.env. For Vercel, set VITE_API_BASE_URL to the full HTTPS
# Render API URL instead.
#
# NOTE: Vite inlines this at BUILD time, not runtime. Changing it
# requires a rebuild of the frontend image / a new Vercel deploy.

VITE_API_BASE_URL=https://api.your-portfolio-domain.com/api
VITE_DEV_API_PROXY_TARGET=https://portfolio-backend-jxap.onrender.com

# Used by the Vercel build script to fetch the CMS snapshot.
# PORTFOLIO_SNAPSHOT_URL may be omitted when it can be derived from
# VITE_API_BASE_URL; set the full Render endpoint for production builds.
PORTFOLIO_SNAPSHOT_URL=https://api.your-portfolio-domain.com/api/public/build-snapshot
# Same secret value as backend PORTFOLIO_SNAPSHOT_TOKEN. Do not prefix with VITE_.
PORTFOLIO_SNAPSHOT_TOKEN=replace-with-the-same-random-secret-as-the-backend

# VERCEL is injected by Vercel automatically; import.meta.env.DEV is supplied by Vite.
