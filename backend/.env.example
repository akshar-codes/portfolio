# Copy to backend/.env and fill in real values.
# NEVER commit the real .env file — it's already in backend/.gitignore.

# --- Core ---------------------------------------------------------
NODE_ENV=production
PORT=5000

# --- Database -------------------------------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# --- Optional one-off database clone (backend/clone-db.js) ------------------
# Separate destination/source connections; never point both at the same DB.
ATLAS_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
LOCAL_MONGO_URI=mongodb://localhost:27017/<database>
# Choose "atlas-to-mongo" or "mongo-to-atlas" before running the clone.
DB_CLONE_DIRECTION=atlas-to-mongo
# Leave blank normally. Set to DROP_DESTINATION_DATABASE only after checking
# the clone plan; the script drops the selected destination database.
DB_CLONE_CONFIRM=

# --- Auth -------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-value-min-32-bytes

# --- Single-admin sign-in (configure the methods you want enabled) ---------
ADMIN_EMAIL=admin@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact URL as an authorized redirect URI in Google Cloud.
GOOGLE_CALLBACK_URL=https://api.your-portfolio-domain.com/api/admin/login/google/callback
# Optional; defaults to JWT_SECRET. Use a separate random secret in production.
OAUTH_SESSION_SECRET=
# Dedicated Gmail account with 2-Step Verification and an app password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- CORS ---------------------------------------------------------------
# Exact origin of the deployed frontend (scheme + host, no trailing slash)
ALLOWED_ORIGIN=https://your-portfolio-domain.com

# --- Cloudinary -----------------------------------------------------------
CLOUD_NAME=your-cloud-name
CLOUD_API_KEY=your-api-key
CLOUD_API_SECRET=your-api-secret

# --- Website email replies and new-message alerts (optional) ----------------
# Configure both Resend values to enable website replies and contact alerts.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Akshar Gupta <replies@your-verified-domain.com>
# Optional destination for new contact-message alerts. Defaults to the
# email in the public Profile settings when omitted.
MESSAGE_NOTIFICATION_EMAIL=

# Optional authenticated requests raise GitHub API rate limits.
GITHUB_TOKEN=

# --- Production snapshot and Vercel publishing -------------------------------
# Shared with frontend Vercel project settings; keep this token secret.
PORTFOLIO_SNAPSHOT_TOKEN=replace-with-a-random-secret-at-least-32-bytes
# Vercel Deploy Hook URL used by Admin > Dashboard > Publish Changes.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/your-hook-id

# --- Migration script only (normally leave unset) ---------------------------
NEW_CLOUD_NAME=
NEW_CLOUD_API_KEY=
NEW_CLOUD_API_SECRET=

# --- Logging (optional, defaults shown) ------------------------------------
LOG_LEVEL=info
